rules_version = '2';

// Clutch production rules.
// Every signed-in person (anonymous auth) can only touch documents keyed by
// their own uid. Everything else is denied by default. Cycle data is
// sensitive, so new collections must be added here explicitly.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // App startup smoke test (ConnectivityCheck.swift).
    match /connectivity_checks/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Shared "report empty" / "it's stocked" taps for free-product spots.
    // Anyone signed in can read them and add their own; nobody can edit or
    // delete one. No personal or cycle data: a spot id, a kind, the
    // anonymous uid and a server timestamp.
    match /spotReports/{report} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['locationId', 'kind', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.locationId is string
        && request.resource.data.locationId.size() < 100
        && request.resource.data.kind in ['empty', 'stocked']
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Per-user data, for anything synced later.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
